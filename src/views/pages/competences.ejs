<%- include('../partials/head', { title: 'Compétences BUT' }) %>
<body>
    <%- include('../partials/nav', { activePage: 'competences' }) %>

    <main>
        <!-- Hero -->
        <section class="hero hero-competences">
            <div class="container">
                <p class="hero-eyebrow fade-in">BUT Informatique</p>
                <h1 class="fade-in delay-1">Mes Compétences</h1>
                <p class="fade-in delay-2">Comment mes projets reflètent les compétences acquises durant mon BUT</p>
            </div>
        </section>

        <!-- Intro -->
        <section class="section comp-intro">
            <div class="container">
                <div class="comp-intro-inner fade-in">
                    <div class="comp-intro-text">
                        <p>Cette page présente les trois compétences que j'ai développées et illustre chacune d'elles à travers mes projets concrets.</p>
                    </div>
                    <div class="comp-badges">
                        <a href="#c1" class="comp-badge comp-badge--c1">
                            <span class="comp-badge-code">C1</span>
                            <span class="comp-badge-label">Réaliser</span>
                        </a>
                        <a href="#c2" class="comp-badge comp-badge--c2">
                            <span class="comp-badge-code">C2</span>
                            <span class="comp-badge-label">Optimiser</span>
                        </a>
                        <a href="#c6" class="comp-badge comp-badge--c6">
                            <span class="comp-badge-code">C6</span>
                            <span class="comp-badge-label">Collaborer</span>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ══════════════════════════
             C1 — RÉALISER
        ══════════════════════════ -->
        <section class="section comp-section" id="c1">
            <div class="container">
                <div class="comp-header fade-in">
                    <div class="comp-header-left">
                        <div class="comp-number comp-number--c1">C1</div>
                        <div>
                            <p class="comp-ue">UE6.1A</p>
                            <h2 class="comp-title">Réaliser</h2>
                            <p class="comp-subtitle">Développer des applications informatiques simples</p>
                        </div>
                    </div>
                    <div class="comp-desc">
                        <p>Cette compétence couvre la capacité à concevoir, développer et déployer des applications fonctionnelles en maîtrisant les langages, les outils et les méthodes adaptés au besoin.</p>
                    </div>
                </div>

                <!-- Apprentissages critiques -->
                <div class="ac-list fade-in delay-1">
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c1"></span>
                        <span>Implémenter des conceptions simples</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c1"></span>
                        <span>Élaborer des conceptions simples</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c1"></span>
                        <span>Faire des essais et évaluer leurs résultats</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c1"></span>
                        <span>Développer des interfaces utilisateurs</span>
                    </div>
                </div>

                <!-- Projets liés -->
                <div class="comp-projects-grid fade-in delay-2">

                    <!-- Emplacement projet -->
                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C1</p>
                        </div>
                    </div>

                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C1</p>
                        </div>
                    </div>


                </div>
            </div>
        </section>

        <div class="comp-divider"></div>

        <!-- ══════════════════════════
             C2 — OPTIMISER
        ══════════════════════════ -->
        <section class="section comp-section bg-light" id="c2">
            <div class="container">
                <div class="comp-header comp-header--reverse fade-in">
                    <div class="comp-header-left">
                        <div class="comp-number comp-number--c2">C2</div>
                        <div>
                            <p class="comp-ue">UE6.2</p>
                            <h2 class="comp-title">Optimiser</h2>
                            <p class="comp-subtitle">Appréhender et construire des algorithmes</p>
                        </div>
                    </div>
                    <div class="comp-desc">
                        <p>Cette compétence vise à analyser un problème, concevoir des algorithmes efficaces et choisir les structures de données adaptées pour répondre aux contraintes de performance.</p>
                    </div>
                </div>

                <div class="ac-list fade-in delay-1">
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c2"></span>
                        <span>Analyser un problème avec ses spécifications</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c2"></span>
                        <span>Comparer des algorithmes pour les problèmes classiques</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c2"></span>
                        <span>Formaliser et mettre en œuvre des outils mathématiques</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c2"></span>
                        <span>Choisir les structures de données complexes adaptées</span>
                    </div>
                </div>

                <div class="comp-projects-grid fade-in delay-2">
                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C2</p>
                        </div>
                    </div>
                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C2</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="comp-divider comp-divider--right"></div>

        <!-- ══════════════════════════
             C6 — COLLABORER
        ══════════════════════════ -->
        <section class="section comp-section" id="c6">
            <div class="container">
                <div class="comp-header fade-in">
                    <div class="comp-header-left">
                        <div class="comp-number comp-number--c6">C6</div>
                        <div>
                            <p class="comp-ue">UE6.6A</p>
                            <h2 class="comp-title">Collaborer</h2>
                            <p class="comp-subtitle">Travailler dans une équipe informatique</p>
                        </div>
                    </div>
                    <div class="comp-desc">
                        <p>Cette compétence recouvre la communication, la gestion de projet en équipe, l'utilisation d'outils collaboratifs et la capacité à s'intégrer dans un environnement professionnel.</p>
                    </div>
                </div>

                <div class="ac-list fade-in delay-1">
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c6"></span>
                        <span>Appréhender l'écosystème numérique</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c6"></span>
                        <span>Découvrir les aptitudes requises selon les différents secteurs</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c6"></span>
                        <span>Identifier les statuts, les fonctions et les rôles de chaque membre</span>
                    </div>
                    <div class="ac-item">
                        <span class="ac-dot ac-dot--c6"></span>
                        <span>Acquérir les compétences interpersonnelles pour travailler en équipe</span>
                    </div>
                </div>

                <div class="comp-projects-grid fade-in delay-2">
                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C6</p>
                        </div>
                    </div>
                    <div class="comp-project-card comp-project-card--placeholder">
                        <div class="placeholder-inner">
                            <span class="placeholder-icon">+</span>
                            <p>Ajouter un projet lié à C6</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="section cta-section">
            <div class="container text-center">
                <h2 class="fade-in">Envie de voir mes projets ?</h2>
                <p class="fade-in delay-1">Retrouve l'ensemble de mes réalisations sur la page projets.</p>
                <a href="/projects" class="btn btn-light fade-in delay-2">Voir mes projets</a>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>

</body>
</html>
