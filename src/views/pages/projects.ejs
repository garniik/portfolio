<%- include('../partials/head', { title: 'Mes Projets' }) %>
<body>
    <%- include('../partials/nav', { activePage: 'projects' }) %>
    
    <main>
        <!-- Hero Section -->
        <section class="hero hero-projects">
            <div class="container">
                <h1 class="fade-in">Mes Projets</h1>
                <p class="fade-in delay-1">Découvrez une sélection de mes réalisations et cas d'études</p>
            </div>
        </section>

        <!-- Filtres de projets -->
        <section class="section">
            <div class="container">
                <div class="filters fade-in">
                    <button class="filter-btn active" data-filter="all">Tous les projets</button>
                    <button class="filter-btn" data-filter="web">Sites Web</button>
                    <button class="filter-btn" data-filter="app">Applications</button>
                    <button class="filter-btn" data-filter="jeu">Jeux</button>
                </div>
            </div>
        </section>

        <!-- Grille des projets -->
        <section class="section pt-0">
            <div class="container">
                <div class="projects-grid">
                    <!-- Projet blue frontline -->
                    <div class="project-card" data-category="jeu">
                        <div class="project-image">
                            <img src="/images/blue_frontline.png" alt="Blue Frontline" class="project-image">
                            <div class="project-overlay">
                                <a href="https://ezekyel0.itch.io/blue-frontline" class="btn btn-small" target="_blank">Jouer</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>Blue Frontline</h3>
                            <p>Jeu de stratégie en tour par tour développé avec Godot</p>
                            <div class="project-tags">
                                <span class="tag">Python</span>
                                <span class="tag">Jeu vidéo</span>
                            </div>
                        </div>
                    </div>


                    <!-- Projet 2 -->
                    <div class="project-card fade-in delay-1" data-category="web">
                        <div class="project-image">
                            <img src="/images/gestionSalle.png" alt="Gestionnaire salle des fete" class="project-image">
                            <div class="project-overlay">
                                <a href="https://github.com/garniik/gestion_salle" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>Gestionnaire salle des fete</h3>
                            <p>App de gestion de reservation pour salle des fetes</p>
                            <div class="project-tags">
                                <span class="tag">PHP</span>
                                <span class="tag">MySQL</span>
                                <span class="tag">site web</span>
                            </div>
                        </div>
                    </div>

                    <!-- Projet 3 -->
                    <div class="project-card fade-in delay-2" data-category="app">
                        <div class="project-image-container">
                            <img src="/images/Minecraft-App.png" alt="apllication guide minecraft" class="project-image">
                            <div class="project-overlay">
                                <a href="https://github.com/Thenoob24/appminecraft" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        
                        <div class="project-info">
                            <h3>apllication guide minecraft</h3>
                            <p>Une application mobile pour montré les craft et les recettes de minecraft</p>
                            <div class="project-tags">
                                <span class="tag">flutter</span>
                                <span class="tag">Application</span>
                            </div>
                        </div>
                    </div>

                    <!-- Projet 4 -->
                    <div class="project-card fade-in" data-category="app">
                        <div class="project-image-container">
                            <img src="/images/nonovMarket.png" alt="application supermarcher" class="project-image">
                            <div class="project-overlay">
                                <a href="https://gitlab.com/nonov1012/nonovmarket" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>application supermarcher</h3>
                            <p>Une application crée une liste de course et trouver le chemin le plus efficace dans un super marcher</p>
                            <div class="technologies">
                                <span>python</span>
                                <span>PyQt6</span>
                                <span>Application</span>
                            </div>
                        </div>
                    </div>

                    <!-- Projet 5 — WIP -->
                    <div class="project-card wip fade-in delay-1" data-category="jeu">
                    <div class="project-image-container">
                        <img src="/images/jeuPerso.png" alt="jeux personnel" class="project-image">
                        <div class="project-overlay">
                        <span class="wip-overlay-text">Ce projet est en cours<br>de développement</span>
                        <span class="btn-wip">⚙ En construction</span>
                        </div>
                        <div class="wip-progress-bar">
                        <div class="wip-progress-fill"></div>
                        </div>
                    </div>
                    <div class="project-info">
                        <div class="badge-wip">En cours</div>
                        <h3>Jeu personnel (Roguelike)</h3>
                        <p>Création d'un jeu vidéo roguelike personnel</p>
                        <div class="technologies">
                        <span>Unity</span>
                        <span>Jeu vidéo</span>
                        </div>
                        <div class="wip-footer">
                        <div class="wip-percent">Avancement <span>10%</span></div>
                        <div class="mini-bar">
                            <div class="mini-bar-fill" style="width: 10%"></div>
                        </div>
                        </div>
                    </div>
                    </div>

                    <!-- Projet 6 -->
                    <div class="project-card fade-in delay-2" data-category="web">
                        <div class="project-image-container">
                            <img src="/images/Movie-Site.jpg" alt="site de notation de film et prediction de notes" class="project-image">
                            <div class="project-overlay">
                                <a href="https://github.com/Hippolyte-LePallec/Movie-Rating-prediction" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>site de notation de film et prediction de notes</h3>
                            <p>Création d'un site web de note de films et prédiction de leurs notes</p>
                            <div class="technologies">
                                <span>PHP</span>
                                <span>MySQL</span>
                                <span>Site web</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pagination -->
                <!-- <div class="pagination fade-in">
                    <a href="#" class="page-link active">1</a>
                    <a href="#" class="page-link">2</a>
                    <a href="#" class="page-link">3</a>
                    <a href="#" class="page-link">Suivant &raquo;</a>
                </div> -->
            </div>
        </section>

        <!-- CTA -->
        <section class="section cta-section">
            <div class="container text-center">
                <h2 class="fade-in">Vous avez un projet en tête ?</h2>
                <p class="fade-in delay-1">Je serais ravi de discuter de votre idée et de voir comment je peux vous aider à la concrétiser.</p>
                <a href="/contact" class="btn btn-light fade-in delay-2">Discutons de votre projet</a>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>