<%- include('../partials/head', { title: 'À propos' }) %>
<body>
    <%- include('../partials/nav', { activePage: 'about' }) %>
    
    <main>
        <!-- Hero Section -->
        <section class="hero hero-about">
            <div class="container">
                <h1 class="fade-in">À propos de moi</h1>
                <p class="fade-in delay-1">Découvrez mon parcours, mes compétences et ma passion pour le développement web</p>
            </div>
        </section>

        <!-- Section À propos -->
        <section class="section">
            <div class="container">
                <div class="about-grid">
                    <div class="about-image fade-in">
                        <img src="/images/profile.jpg" alt="[Votre Nom]" class="profile-img">
                    </div>
                    <div class="about-content fade-in delay-1">
                        <h2>Qui suis-je ?</h2>
                        <p>Je m'appelle Antoine Arnoult et je suis un développeur web passionné par la création d'expériences numériques exceptionnelles. Avec plusieurs années d'expérience dans le développement web, j'ai eu l'opportunité de travailler sur une variété de projets stimulants qui ont renforcé mes compétences et ma passion pour ce domaine.</p>
                        <p>Ma philosophie de travail repose sur l'innovation, la qualité et l'attention aux détails. Je m'efforce de créer des solutions qui non seulement répondent aux besoins de mes clients, mais qui dépassent également leurs attentes.</p>
                        
                        <div class="personal-info">
                            <div class="info-item">
                                <span class="info-label">Nom :</span>
                                <span class="info-value">Arnoult Antoine</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Email :</span>
                                <span class="info-value">arnoult.antoinepro@gmail.com</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Téléphone :</span>
                                <span class="info-value">+33 6 37 40 98 08</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Localisation :</span>
                                <span class="info-value">Calais, France</span>

                            </div>
                        </div>
                        
                        <a href="/contact" class="btn mt-4">Me contacter</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Mon but en 180 sec -->
        <section class="section video-section">
            <div class="container">
                <div class="section-title">
                    <h2>Mon but en 180 sec</h2>
                    <p>Découvrez ma vision et mes objectifs en 3 minutes</p>
                </div>

                <div class="video-container fade-in">
                    <div class="video-wrapper">
                        <video controls class="video-player">
                            <source src="/videos/mon-but-180sec.mp4" type="video/mp4">
                            Votre navigateur ne supporte pas la lecture de vidéos.
                        </video>
                    </div>
                </div>
            </div>
        </section>

        <!-- Compétences -->
        <section class="section bg-light">
            <div class="container">
                <div class="section-title">
                    <h2>Mes Compétences</h2>
                    <p>Un aperçu de mes compétences techniques et professionnelles</p>
                </div>
                
                <div class="skills-container">
                    <% skills.forEach(skill => { %>
                        <div class="skill fade-in">
                            <div class="skill-header">
                                <h3><%= skill.name %></h3>
                                <div class="skill-icon">
                                    <i class="fas fa-check-circle"></i>
                                </div>
                            </div>
                            <p class="skill-description"><%= skill.description %></p>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- Parcours -->
        <section class="section">
            <div class="container">
                <div class="section-title">
                    <h2>Mon Parcours</h2>
                    <p>Mon expérience professionnelle et ma formation</p>
                </div>
                
                <div class="timeline">
                    <!-- formation 2 -->
                    <div class="timeline-item fade-in">
                        <div class="timeline-date">2023 - Présent</div>
                        <div class="timeline-content">
                            <h3>IUT Informatique</h3>
                            <h4>Calais, France</h4>
                            <p>Formation en Informatique et développement web.</p>
                        </div>
                    </div>
                    
                    <!-- formation 1 -->
                    <div class="timeline-item fade-in delay-1">
                        <div class="timeline-date">2021 - 2023</div>
                        <div class="timeline-content">
                            <h3>BAC technologique Specialité SIN, Lycée leonar de vincie (HQE)</h3>
                            <h4>Calais, France</h4>
                            <p>Formation en Informatique et développement web.</p>
                        </div>
                    </div>
                    
                </div>
            </div>
        </section>

        <!-- Pourquoi me choisir -->
        <section class="section bg-light">
            <div class="container">
                <div class="section-title">
                    <h2>Pourquoi me choisir ?</h2>
                    <p>Ce qui fait la différence dans mon travail</p>
                </div>
                
                <div class="features-grid">
                    <div class="feature-card fade-in">
                        <div class="feature-icon">
                            <i class="fas fa-code"></i>
                        </div>
                        <h3>Code Propre</h3>
                        <p>Je m'engage à écrire un code propre, bien documenté et facile à maintenir, en suivant les meilleures pratiques du secteur.</p>
                    </div>
                    
                    <div class="feature-card fade-in delay-1">
                        <div class="feature-icon">
                            <i class="fas fa-mobile-alt"></i>
                        </div>
                        <h3>Design Réactif</h3>
                        <p>Je crée des sites web qui s'adaptent parfaitement à tous les appareils, des ordinateurs de bureau aux smartphones.</p>
                    </div>
                    
                    <div class="feature-card fade-in delay-2">
                        <div class="feature-icon">
                            <i class="fas fa-rocket"></i>
                        </div>
                        <h3>Performance</h3>
                        <p>J'optimise chaque projet pour des temps de chargement rapides et une expérience utilisateur fluide.</p>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- CTA -->
        <section class="section cta-section">
            <div class="container text-center">
                <h2 class="fade-in">Prêt à concrétiser votre projet ?</h2>
                <p class="fade-in delay-1">Je suis là pour vous aider à donner vie à vos idées. Contactez-moi dès aujourd'hui pour discuter de votre projet.</p>
                <a href="/contact" class="btn btn-light fade-in delay-2">Me contacter</a>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
