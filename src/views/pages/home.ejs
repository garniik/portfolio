<%- include('../partials/head', { title: 'Accueil' }) %>
<body>
    <%- include('../partials/nav', { activePage: 'home' }) %>
    
    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-content">
                        <h1 class="fade-in">Bonjour, je suis <span class="highlight">Antoine Arnoult</span></h1>
                        <p class="fade-in delay-1">Développeur passionné par la création</p>
                        <div class="cta-buttons fade-in delay-2">
                            <a href="/projects" class="btn">Voir mes projets</a>
                            <a href="/contact" class="btn btn-outline">Me contacter</a>
                        </div>
                    </div>
                    <div class="hero-image fade-in delay-1">
                        <img src="/images/photo_profil.jpg" alt="Antoine Arnoult - Développeur Web" class="profile-img-hero">
                    </div>
                </div>
            </div>
        </section>

        <!-- À propos (Section courte) -->
        <section class="section">
            <div class="container">
                <div class="section-title">
                    <h2>À propos de moi</h2>
                </div>
                <div class="about-short">
                    <div class="about-content fade-in">
                        <p>Je suis étudiant en troisième année de BUT Informatique à l’IUT de Calais et passionné par le développement. 
                        J’aime concevoir des projets informatiques, que ce soit des applications web ou des jeux vidéo. 
                        Au cours de mes études, j’ai appris à travailler avec plusieurs langages et outils de développement, tout en participant à des projets d’équipe et des événements comme la Nuit de l’Info. 
                        Curieux et créatif, j’aime comprendre comment les technologies fonctionnent et les utiliser pour créer mes propres projets.
                        </p>
                        <a href="/about" class="btn">En savoir plus</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Derniers Projets -->
        <section class="section bg-light">
            <div class="container">
                <div class="section-title">
                    <h2>Mes Derniers Projets</h2>
                    <p>Découvrez une sélection de mes réalisations récentes</p>
                </div>
                <div class="projects-grid">
                    <!-- template
                    
                    <div class="project-card fade-in">
                        <img src="/images/project1.jpg" alt="Projet 1" class="project-image">
                        <div class="project-info">
                            <h3>nom du projet</h3>
                            <p>description du projet</p>
                            <div class="technologies">
                                <span>technos</span>
                            </div>
                            <a href="#" class="btn">Voir le projet</a>
                        </div>
                    </div> 

                    -->
                    <!-- Projet 1 -->
                    <div class="project-card" data-category="jeu">
                        <div class="project-image">
                            <img src="/images/blue_frontline.png" alt="Blue Frontline" class="project-image">
                            <div class="project-overlay">
                                <a href="https://ezekyel0.itch.io/blue-frontline" class="btn btn-small" target="_blank">Jouer</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>Blue Frontline</h3>
                            <p>Jeu de stratégie en tour par tour développé avec Godot</p>
                            <div class="project-tags">
                                <span class="tag">Python</span>
                                <span class="tag">Jeu vidéo</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Projet 2 -->
                    <div class="project-card fade-in delay-1" data-category="web">
                        <div class="project-image">
                            <img src="/images/gestionSalle.png" alt="Gestionnaire salle des fete" class="project-image">
                            <div class="project-overlay">
                                <a href="https://github.com/garniik/gestion_salle" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>Gestionnaire salle des fete</h3>
                            <p>App de gestion de reservation pour salle des fetes</p>
                            <div class="project-tags">
                                <span class="tag">PHP</span>
                                <span class="tag">MySQL</span>
                                <span class="tag">site web</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Projet 3 -->
                    <div class="project-card fade-in" data-category="app">
                        <div class="project-image-container">
                            <img src="/images/nonovMarket.png" alt="application supermarcher" class="project-image">
                            <div class="project-overlay">
                                <a href="https://gitlab.com/nonov1012/nonovmarket" class="btn btn-view">Voir le projet</a>
                            </div>
                        </div>
                        <div class="project-info">
                            <h3>application supermarcher</h3>
                            <p>Une application crée une liste de course et trouver le chemin le plus efficace dans un super marcher</p>
                            <div class="technologies">
                                <span>python</span>
                                <span>PyQt6</span>
                                <span>Application</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="text-center mt-4 fade-in delay-3">
                    <a href="/projects" class="btn">Voir tous les projets</a>
                </div>
            </div>
        </section>

        <!-- Compétences clés -->
        <section class="section">
            <div class="container">
                <div class="section-title">
                    <h2>Mes Compétences</h2>
                    <p>Technologies et outils que j'utilise au quotidien</p>
                </div>
                <div class="skills-container">
                    <div class="comp-badges">
                        <a href="#c1" class="comp-badge comp-badge--c1">
                            <span class="comp-badge-code">C1</span>
                            <span class="comp-badge-label">Réaliser</span>
                            <div class="comp-desc">
                                <p>Cette compétence couvre la capacité à concevoir, développer et déployer des applications fonctionnelles en maîtrisant les langages, les outils et les méthodes adaptés au besoin.</p>
                            </div>
                        </a>
                        <a href="#c2" class="comp-badge comp-badge--c2">
                            <span class="comp-badge-code">C2</span>
                            <span class="comp-badge-label">Optimiser</span>
                            <div class="comp-desc">
                                <p>Cette compétence consiste à améliorer les performances, la maintenabilité et l'expérience utilisateur de vos applications, en analysant et en optimisant le code et les ressources.</p>
                            </div>
                        </a>
                        <a href="#c6" class="comp-badge comp-badge--c6">
                            <span class="comp-badge-code">C6</span>
                            <span class="comp-badge-label">Collaborer</span>
                            <div class="comp-desc">
                                <p>Cette compétence met l'accent sur la communication, la gestion de projet et la collaboration en équipe pour mener à bien des projets informatiques de manière efficace et professionnelle.</p>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="text-center mt-4 fade-in delay-3">
                    <a href="/competences" class="btn">Voir toutes les compétences</a>
                </div>
            </div>
        </section>

        <!-- Section Contact -->
        <section class="section bg-light">
            <div class="container">
                <div class="section-title">
                    <h2>Travaillons ensemble</h2>
                    <p>N'hésitez pas à me contacter pour discuter de votre projet</p>
                </div>
                <div class="contact-cta text-center fade-in">
                    <p>Vous avez un projet en tête ou souhaitez en savoir plus sur mon travail ? Je serais ravi d'échanger avec vous.</p>
                    <a href="/contact" class="btn btn-primary mt-3">Me contacter</a>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>